FROM docker.io/library/golang:1.27.2-bookworm

# The posts commit to Git; the container has no identity of its own.
ENV GOTOOLCHAIN=local \
    GIT_AUTHOR_NAME=Reader GIT_AUTHOR_EMAIL=reader@example.com \
    GIT_COMMITTER_NAME=Reader GIT_COMMITTER_EMAIL=reader@example.com

# Fences marked `imports` stand for an editor that adds imports on save.
RUN go install golang.org/x/tools/cmd/goimports@v0.51.0

COPY runner/main.go /src/runner/main.go
RUN go build -o /usr/local/bin/tutorial-runner /src/runner/main.go

# Writable by whichever user the engine runs as.
RUN mkdir -p /work && chmod 1777 /work
WORKDIR /work
ENTRYPOINT ["sh", "-c", "tutorial-runner /post.mdx > /tmp/tutorial.sh && exec bash /tmp/tutorial.sh"]
