---
import { type YearEntry, yearHref } from "@/lib/blog.ts";

interface Props {
  years: YearEntry[];
  class?: string;
}

const { years, class: className } = Astro.props;
---

<nav
  aria-label="Jump to year"
  class:list={["-mx-4 -mt-2 flex gap-2 overflow-x-auto px-4 pb-1", className]}
>
  {
    years.map((y) => (
      <a
        href={yearHref(y)}
        class="inline-flex min-h-10 shrink-0 items-center rounded-full bg-slate-100 px-3.5 font-mono text-sm text-slate-900 transition hover:bg-slate-200 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700"
      >
        {y.year}
      </a>
    ))
  }
</nav>
