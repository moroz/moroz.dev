---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatStarted } from "@/lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h3" } = Astro.props;
const { data } = project;
const href = `/portfolio/${data.slug}/`;
const Heading = headingLevel;
---

<article
  class="group relative overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
>
  {
    data.cover && (
      <div class="overflow-hidden bg-slate-100 dark:bg-slate-950">
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ""}
          widths={[640, 960, 1440]}
          sizes="(min-width: 65rem) 64rem, 100vw"
          class="w-full transition duration-500 group-hover:scale-[1.02]"
        />
      </div>
    )
  }
  <div class="desktop:p-8 grid gap-4 p-5">
    <div class="flex items-center gap-4">
      {
        data.icon && (
          <Image
            src={data.icon}
            alt=""
            width={64}
            height={64}
            class="h-14 w-14 shrink-0 rounded-2xl shadow-sm"
          />
        )
      }
      <div>
        <Heading class="text-2xl leading-tight font-bold">
          <a href={href} class="text-primary hover:text-primary-hover after:absolute after:inset-0">
            {data.title}
          </a>
        </Heading>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Started {formatStarted(data.started)} · {data.status}
        </p>
      </div>
    </div>
    <p class="max-w-3xl text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      {data.tagline}
    </p>
    {
      data.highlights.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {data.highlights.map((h) => (
            <li class="rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">
              {h}
            </li>
          ))}
        </ul>
      )
    }
    <ul class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
      {data.stack.slice(0, 6).map((s) => <li>{s}</li>)}
      {data.stack.length > 6 && <li>+{data.stack.length - 6} more</li>}
    </ul>
    <p class="text-primary font-semibold">
      Project notes <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">→</span>
    </p>
  </div>
</article>
