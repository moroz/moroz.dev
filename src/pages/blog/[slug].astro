---
import Layout from "@layouts/Layout.astro";
import { render, getEntry, getCollection } from "astro:content";
import PostDate from "@components/blog/post-date.astro";
const { slug } = Astro.params;

export async function getStaticPaths() {
  const displayDrafts = process.env.NODE_ENV === "development";
  let allBlogPosts = await getCollection("blog");
  if (!displayDrafts) {
    allBlogPosts = allBlogPosts.filter((p) => !p.data.draft);
  }
  return allBlogPosts.map((post) => ({ params: { slug: post.id } }));
}

const post = await getEntry("blog", slug)!;

const { Content } = await render(post);

const { title, series, part } = post.data;
const kicker = series && [series, part].filter(Boolean).join(" · ");
const documentTitle = series ? `${title} – ${kicker}` : title;
---

<script>
  import "@/lib/snippets.ts";
  import { backHref } from "@/lib/blog-href.ts";

  const back = document.querySelector<HTMLAnchorElement>("a[data-back]");
  if (back) back.href = backHref(location.search);
</script>

<Layout {title} {kicker} {documentTitle}>
  <a
    slot="nav"
    href="/blog/"
    data-back
    class="not-prose text-primary hover:text-primary-hover text-sm font-semibold"
  >
  <span aria-hidden="true">«</span> Back to the blog
  </a>
  <p class="text-center">
    <strong>Karol Moroz</strong>{
      post.data.datePrecision === "month" ? ", " : " on "
    }<PostDate
      date={post.data.date}
      precision={post.data.datePrecision}
    />
  </p>

  <div class="content mx-auto my-8" lang={post.data.lang}>
    <Content />
  </div>
</Layout>
