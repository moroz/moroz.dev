---
import { Image } from "astro:assets";
import { render } from "astro:content";
import RootLayout from "@layouts/RootLayout.astro";
import { checkSections, formatStarted, getProjects } from "@/lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
checkSections(project, headings);
// Documents (PDFs) are repeated after the text; otherwise the first link is.
const pdfLinks = data.links.filter((link) => link.href.endsWith(".pdf"));
const closingLinks = pdfLinks.length > 0 ? pdfLinks : data.links.slice(0, 1);
---

<RootLayout title={data.title}>
  <main class="flex-1 pt-16 pb-16">
    <div class="mobile:px-4">
      <nav class="container mx-auto mt-6 max-w-5xl text-sm xl:mt-10">
        <a href="/portfolio/" class="text-primary hover:text-primary-hover font-semibold">
          <span aria-hidden="true">←</span> Portfolio
        </a>
      </nav>

      <header class="container mx-auto mt-6 max-w-5xl">
        <div class="flex items-center gap-5">
          {
            data.icon && (
              <Image
                src={data.icon}
                alt=""
                width={96}
                height={96}
                class="desktop:h-24 desktop:w-24 h-16 w-16 shrink-0 rounded-[22%] shadow-md"
              />
            )
          }
          <div>
            <h1 class="text-4xl leading-tight font-bold xl:text-6xl">{data.title}</h1>
            <p class="mt-1 text-slate-600 dark:text-slate-400">Started {formatStarted(data.started)} · {data.status}</p>
          </div>
        </div>
        <p
          class="mt-6 max-w-3xl text-xl leading-relaxed text-slate-700 xl:text-2xl dark:text-slate-300"
        >
          {data.tagline}
        </p>

        {
          data.highlights.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {data.highlights.map((h) => (
                <li class="bg-primary/10 text-primary rounded-full px-3 py-1 text-sm font-semibold">
                  {h}
                </li>
              ))}
            </ul>
          )
        }

        <dl
          class="desktop:grid-cols-[auto_1fr] mt-8 grid gap-x-8 gap-y-3 border-y border-slate-200 py-5 dark:border-slate-800"
        >
          <dt class="font-semibold">Role</dt>
          <dd class="text-slate-700 dark:text-slate-300">{data.role}</dd>
          <dt class="font-semibold">Stack</dt>
          <dd>
            <ul class="flex flex-wrap gap-2">
              {
                data.stack.map((s) => (
                  <li class="rounded-md bg-slate-100 px-2 py-0.5 text-sm dark:bg-slate-800">
                    {s}
                  </li>
                ))
              }
            </ul>
          </dd>
        </dl>

        {
          data.links.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-3">
              {data.links.map((link, i) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      "inline-flex items-center gap-2 rounded-lg px-4 py-2 font-semibold transition",
                      i === 0
                        ? "bg-primary hover:bg-primary-hover text-white dark:text-black"
                        : "border-primary text-primary border",
                    ]}
                  >
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        data.cover && (
          <div class="container mx-auto mt-10 max-w-6xl">
            <Image
              src={data.cover}
              alt={data.coverAlt ?? ""}
              widths={[640, 1280, 1920]}
              sizes="(min-width: 72rem) 72rem, 100vw"
              class="w-full rounded-xl shadow-lg"
            />
          </div>
        )
      }

      <div class="content mx-auto my-12">
        <Content />
      </div>

      {
        closingLinks.length > 0 && (
          <aside class="container mx-auto max-w-180 rounded-xl bg-slate-100 p-6 text-center dark:bg-slate-900">
            <p class="mb-3 text-lg">Full technical description</p>
            <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
              {closingLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:text-primary-hover text-lg font-bold"
                  >
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </main>
</RootLayout>
